# A prebuilt engine: the libraries a project links, compiled once in Release, so a project compiles only its own code.
# `python . prebuilt` writes the package (engine_export_prebuilt); ENGINE_PREBUILT_DIR makes a project use it
# (engine_use_prebuilt). Details: Docs/Prebuilt.md.

# The runtime the package is built with. A project's development build links the same libraries, so both use it.
set(ENGINE_PREBUILT_RUNTIME MultiThreadedDLL)
set(ENGINE_PREBUILT_ROOTS Engine EngineAssets EngineHeadless EngineLocalization EngineNumberPopup EnginePersistence EnginePopup
    EngineProfiler EngineProfilerRuntime EngineRunTracking EngineRunTrackingRuntime EngineScoreBoard EngineSteam
    EngineVersion EngineWorkerRuntime)

# Follows link dependencies; `seen` receives every target reachable from `roots`.
function(_engine_prebuilt_walk seen)
    set(result "${${seen}}")
    foreach(item IN LISTS ARGN)
        string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" item "${item}")
        if(NOT TARGET "${item}")
            # A package target only its third-party folder sees (Threads::Threads, nothing to link with MSVC).
            if(item MATCHES "^[A-Za-z0-9_]+::[A-Za-z0-9_]+$")
                set_property(GLOBAL APPEND PROPERTY ENGINE_PREBUILT_SCOPED "${item}")
            endif()
            continue()
        endif()
        get_target_property(aliased "${item}" ALIASED_TARGET)
        if(aliased)
            set_property(GLOBAL APPEND PROPERTY ENGINE_PREBUILT_ALIASES "${item}=${aliased}")
            set(item "${aliased}")
        endif()
        if("${item}" IN_LIST result)
            continue()
        endif()
        list(APPEND result "${item}")
        get_target_property(links "${item}" INTERFACE_LINK_LIBRARIES)
        if(links)
            _engine_prebuilt_walk(result ${links})
        endif()
    endforeach()
    set(${seen} "${result}" PARENT_SCOPE)
endfunction()

function(engine_export_prebuilt output)
    get_filename_component(engineRoot "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(targets)
    _engine_prebuilt_walk(targets ${ENGINE_PREBUILT_ROOTS})
    set(properties INTERFACE_COMPILE_DEFINITIONS INTERFACE_COMPILE_FEATURES INTERFACE_COMPILE_OPTIONS
        INTERFACE_INCLUDE_DIRECTORIES INTERFACE_LINK_LIBRARIES INTERFACE_LINK_OPTIONS
        INTERFACE_SYSTEM_INCLUDE_DIRECTORIES)
    set(text "# Generated by python . prebuilt; do not edit.\n")
    set(copies)
    foreach(target IN LISTS targets)
        get_target_property(type "${target}" TYPE)
        get_target_property(imported "${target}" IMPORTED)
        # An OBJECT library's code is inside the library that used it (GLFW in raylib); only its usage remains.
        if(type STREQUAL "INTERFACE_LIBRARY" OR type STREQUAL "OBJECT_LIBRARY" OR imported)
            string(APPEND text "add_library(${target} INTERFACE IMPORTED GLOBAL)\n")
        elseif(type STREQUAL "STATIC_LIBRARY")
            string(APPEND text "add_library(${target} STATIC IMPORTED GLOBAL)\nset_target_properties(${target} "
                "PROPERTIES IMPORTED_LOCATION \"\${ENGINE_PREBUILT_DIR}/Lib/${target}.lib\")\n")
            list(APPEND copies COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:${target}>"
                "${output}/Lib/${target}.lib")
        else()
            message(FATAL_ERROR "Prebuilt engine: ${target} has unsupported type ${type}")
        endif()
        foreach(property IN LISTS properties)
            get_target_property(value "${target}" ${property})
            if(imported AND property STREQUAL "INTERFACE_LINK_LIBRARIES")
                # A system library found on the packaging machine (OpenGL): its plain name works on any machine.
                get_target_property(name "${target}" IMPORTED_LIBNAME)
                get_target_property(location "${target}" IMPORTED_LOCATION)
                if(name)
                    set(value "${name}")
                elseif(location)
                    get_filename_component(value "${location}" NAME)
                endif()
            endif()
            if(value AND (property STREQUAL "INTERFACE_INCLUDE_DIRECTORIES" OR property STREQUAL "INTERFACE_SYSTEM_INCLUDE_DIRECTORIES"))
                # A dependency's own build folder (Box2D's generated headers) means nothing in a package.
                set(entries "${value}")
                set(value)
                foreach(entry IN LISTS entries)
                    string(FIND "${entry}" "$<BUILD_INTERFACE:${CMAKE_BINARY_DIR}" inBuildTree)
                    if(NOT inBuildTree EQUAL 0)
                        list(APPEND value "${entry}")
                    endif()
                endforeach()
            endif()
            if(value)
                string(REGEX REPLACE "::@[^;]*;?" "" value "${value}") # Link scope markers of other directories
                string(FIND "${value}" "${CMAKE_BINARY_DIR}" inBuildTree)
                if(NOT inBuildTree EQUAL -1)
                    message(FATAL_ERROR "Prebuilt engine: ${target} ${property} points into the build tree: ${value}")
                endif()
                string(REPLACE "\\" "\\\\" value "${value}")
                string(REPLACE "\"" "\\\"" value "${value}")
                string(REPLACE "${engineRoot}" "\${ENGINE_PREBUILT_SOURCE_ROOT}" value "${value}")
                string(APPEND text "set_target_properties(${target} PROPERTIES ${property} \"${value}\")\n")
            endif()
        endforeach()
    endforeach()
    get_property(scoped GLOBAL PROPERTY ENGINE_PREBUILT_SCOPED)
    string(APPEND text "add_executable(EngineCrashReporter IMPORTED GLOBAL)\nset_target_properties(EngineCrashReporter "
        "PROPERTIES IMPORTED_LOCATION \"\${ENGINE_PREBUILT_DIR}/Diagnostics/EngineCrashReporter.exe\")\n")
    list(REMOVE_DUPLICATES scoped)
    foreach(name IN LISTS scoped)
        string(APPEND text "add_library(${name} INTERFACE IMPORTED GLOBAL)\n")
    endforeach()
    get_property(aliases GLOBAL PROPERTY ENGINE_PREBUILT_ALIASES)
    list(REMOVE_DUPLICATES aliases)
    foreach(alias IN LISTS aliases)
        string(REPLACE "=" ";" parts "${alias}")
        list(GET parts 0 name)
        list(GET parts 1 real)
        string(APPEND text "add_library(${name} ALIAS ${real})\n")
    endforeach()
    # Plain text: the properties' generator expressions are evaluated where the project uses them, not here.
    file(WRITE "${output}/EngineTargets.cmake" "${text}")
    file(WRITE "${output}/Prebuilt.json"
"{
  \"engine\": \"${engineVersion}\",
  \"compiler\": \"${CMAKE_CXX_COMPILER_VERSION}\"
}
")
    add_custom_target(EnginePrebuiltPackage ALL
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${output}/Lib" "${output}/Editor" "${output}/Diagnostics"
        ${copies}
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:EngineEditor>" "${output}/Editor"
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:EngineCrashReporter>" "${output}/Diagnostics"
        DEPENDS ${ENGINE_PREBUILT_ROOTS} EngineEditor EngineCrashReporter VERBATIM)
endfunction()

# Sets `usable` to whether this project can link the package at ENGINE_PREBUILT_DIR; a reason goes to the output.
function(_engine_prebuilt_usable usable)
    set(${usable} FALSE PARENT_SCOPE)
    set(package "${ENGINE_PREBUILT_DIR}/Prebuilt.json")
    if(NOT EXISTS "${package}")
        message(STATUS "Prebuilt engine: ${package} not found; building the engine from source")
        return()
    endif()
    if(NOT EXISTS "${ENGINE_PREBUILT_DIR}/Diagnostics/EngineCrashReporter.exe" OR
       NOT EXISTS "${ENGINE_PREBUILT_DIR}/Lib/EngineDiagnostics.lib")
        message(STATUS "Prebuilt engine: diagnostics are missing; building the engine from source")
        return()
    endif()
    if(NOT MSVC)
        message(STATUS "Prebuilt engine: needs MSVC; building the engine from source")
        return()
    endif()
    file(READ "${package}" description)
    string(JSON packageEngine GET "${description}" engine)
    string(JSON packageCompiler GET "${description}" compiler)
    if(NOT packageEngine STREQUAL engineVersion)
        message(STATUS "Prebuilt engine: package is ${packageEngine}, this engine ${engineVersion}; "
            "building the engine from source")
        return()
    endif()
    # A linker must be at least as new as the tools that built its inputs.
    if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS packageCompiler)
        message(STATUS "Prebuilt engine: needs MSVC ${packageCompiler} or newer, found "
            "${CMAKE_CXX_COMPILER_VERSION}; building the engine from source")
        return()
    endif()
    if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL ENGINE_PREBUILT_RUNTIME)
        message(STATUS "Prebuilt engine: this project chooses its own C++ runtime; building the engine from source")
        return()
    endif()
    if(ENGINE_BUILD_TESTS OR ENGINE_BUILD_EDITOR_TESTS)
        message(STATUS "Prebuilt engine: tests need Debug engine code; building the engine from source")
        return()
    endif()
    set(${usable} TRUE PARENT_SCOPE)
endfunction()

# Loads the package's targets instead of the engine's sources. Sets ENGINE_PREBUILT_USED in the cache for the tools.
macro(engine_use_prebuilt)
    _engine_prebuilt_usable(enginePrebuiltUsable)
    set(ENGINE_PREBUILT_USED ${enginePrebuiltUsable} CACHE INTERNAL "Whether the project links the prebuilt engine")
    if(enginePrebuiltUsable)
        message(STATUS "Prebuilt engine: ${ENGINE_PREBUILT_DIR}")
        set(ENGINE_THIRD_PARTY_DIR "${CMAKE_CURRENT_SOURCE_DIR}/ThirdParty" CACHE INTERNAL "Engine's vendored dependencies")
        set(ENGINE_PREBUILT_SOURCE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}")
        # The project's own code too: the libraries are Release, so its development build uses their runtime.
        set(CMAKE_MSVC_RUNTIME_LIBRARY ${ENGINE_PREBUILT_RUNTIME} PARENT_SCOPE)
        include("${ENGINE_PREBUILT_DIR}/EngineTargets.cmake")
        include("${CMAKE_CURRENT_SOURCE_DIR}/Core/ProjectTargets.cmake")
        if(ENGINE_BUILD_EDITOR)
            include("${CMAKE_CURRENT_SOURCE_DIR}/Editor/WorkerTargets.cmake")
        endif()
        return()
    endif()
endmacro()
