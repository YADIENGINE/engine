{
  "version": 1,
  "name": "MyProject",
  "game": {
    "target": "MyProject",
    "buildDirectory": "build",
    "configurePreset": "desktop",
    "buildPresets": { "Debug": "debug", "Release": "release" }
  },
  "package": {
    "directory": "Final",
    "name": "MyProject",
    "files": []
  },
  "tests": {
    "buildDirectory": "build/tests",
    "configurePreset": "tests",
    "buildPreset": "tests-debug",
    "testPreset": "tests-debug"
  },
  "editor": {
    "buildDirectory": "build/editor",
    "worker": "MyProjectPreview",
    "cacheVariables": {
      "MYPROJECT_BUILD_GAME": "OFF",
      "MYPROJECT_BUILD_EDITOR": "ON",
      "MYPROJECT_BUILD_TESTS": "OFF"
    }
  }
}
